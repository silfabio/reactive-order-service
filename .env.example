# Local Development Environment Variables
# These are the default credentials used by the docker-compose setup.
# Copy this file to .env to run the application locally.

# PostgreSQL Credentials
DB_PASSWORD=password
DB_USER=user

# Grafana Credentials
GRAFANA_ADMIN_PASSWORD=admin

# Grafana Alert Notifications
# Set this to the email address that should receive Grafana alerts (high latency,
# errors, app down, etc.). Terraform reads it as TF_VAR_alert_email and provisions
# the Grafana contact point — it is never committed to source control.
ALERT_EMAIL=you@example.com
